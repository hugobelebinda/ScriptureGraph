{
  "name": "scripturegraph",
  "private": true,
  "type": "module",
  "workspaces": [
    "Backend",
    "Frontend"
  ],
  "scripts": {
    "download-bible": "tsx scripts/download-bible.ts",
    "build:interlinear": "tsx scripts/build-interlinear.ts",
    "build:atlas-mosaic": "tsx scripts/build-atlas-mosaic.ts",
    "generate:book-covers": "node scripts/generate-book-cover-svgs.mjs",
    "security:secrets": "node scripts/security/01-secret-management-audit.mjs",
    "security:ratelimit": "node scripts/security/02-rate-limit-check.mjs",
    "security:rls": "node scripts/security/03-supabase-rls-check.mjs",
    "security:cors": "node scripts/security/04-cors-network-check.mjs",
    "security:validation": "node scripts/security/05-input-validation-check.mjs",
    "security:audit": "npm run security:secrets && npm run security:ratelimit && npm run security:rls && npm run security:cors && npm run security:validation",
    "dev:api": "npm run dev -w scripturegraph-backend",
    "dev:web": "npm run dev -w scripturegraph-frontend",
    "postinstall": "npm run prisma:generate -w scripturegraph-backend",
    "prisma:generate": "npm run prisma:generate -w scripturegraph-backend"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

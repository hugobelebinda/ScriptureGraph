{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PS2","translationId":"eng_web","name":"Psalm 151","commonName":"Psalm 151","title":"Psalm 151","order":84,"numberOfChapters":1,"isApocryphal":true,"sha256":"550820dcf3daa6bec80896b3da6bf3f3af395e2b25ca7a3eb05d7eee984dec01","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PS2/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/eng_web/PS2/1.json","totalNumberOfVerses":7},"chapter":{"number":1,"content":[{"type":"hebrew_subtitle","content":["This Psalm is a genuine one of David, though extra,",{"noteId":0},"composed when he fought in single combat with Goliath."]},{"type":"verse","number":1,"content":[{"text":"I was small among my brothers,","poem":1},{"text":"and youngest in my father’s house.","poem":2},{"lineBreak":true},{"text":"I tended my father’s sheep.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"My hands formed a musical instrument,","poem":1},{"text":"and my fingers tuned a lyre.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Who shall tell my Lord?","poem":1},{"text":"The Lord himself, he himself hears.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He sent forth his angel and took me from my father’s sheep,","poem":1},{"text":"and he anointed me with his anointing oil.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"My brothers were handsome and tall;","poem":1},{"text":"but the Lord didn’t take pleasure in them.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I went out to meet the Philistine,","poem":1},{"text":"and he cursed me by his idols.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"But I drew his own sword and beheaded him,","poem":1},{"text":"and removed reproach from the children of Israel.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"or, supernumerary","reference":{"chapter":1,"verse":0}}]},"thisChapterLink":"/api/eng_web/PS2/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/DAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/MAN/1.json","previousChapterAudioLinks":{},"numberOfVerses":7}
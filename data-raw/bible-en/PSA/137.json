{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"By the rivers of Babylon, there we sat down.","poem":1},{"text":"Yes, we wept, when we remembered Zion.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"On the willows in that land,","poem":1},{"text":"we hung up our harps.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For there, those who led us captive asked us for songs.","poem":1},{"text":"Those who tormented us demanded songs of joy:","poem":2},{"lineBreak":true},{"text":"“Sing us one of the songs of Zion!”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"How can we sing Yahweh’s song in a foreign land?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"If I forget you, Jerusalem,","poem":1},{"text":"let my right hand forget its skill.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Let my tongue stick to the roof of my mouth if I don’t remember you,","poem":1},{"text":"if I don’t prefer Jerusalem above my chief joy.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Remember, Yahweh, against the children of Edom in the day of Jerusalem,","poem":1},{"text":"who said, “Raze it!","poem":2},{"lineBreak":true},{"text":"Raze it even to its foundation!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Daughter of Babylon, doomed to destruction,","poem":1},{"text":"he will be happy who repays you,","poem":2},{"lineBreak":true},{"text":"as you have done to us.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Happy shall he be,","poem":1},{"text":"who takes and dashes your little ones against the rock.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}
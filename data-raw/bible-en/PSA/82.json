back and forth in darkness.","poem":2},{"lineBreak":true},{"text":"All the foundations of the earth are shaken.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I said, “You are gods,","poem":1},{"text":"all of you are sons of the Most High.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nevertheless you shall die like men,","poem":1},{"text":"and fall like one of the rulers.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Arise, God, judge the earth,","poem":1},{"text":"for you inherit all of the nations.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}
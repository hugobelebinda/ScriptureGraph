{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"In my distress, I cried to Yahweh.","poem":1},{"text":"He answered me.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Deliver my soul, Yahweh, from lying lips,","poem":1},{"text":"from a deceitful tongue.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"What will be given to you, and what will be done more to you,","poem":1},{"text":"you deceitful tongue?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sharp arrows of the mighty,","poem":1},{"text":"with coals of juniper.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Woe is me, that I live in Meshech,","poem":1},{"text":"that I dwell among the tents of Kedar!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"My soul has had her dwelling too long","poem":1},{"text":"with him who hates peace.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I am for peace,","poem":1},{"text":"but when I speak, they are for war.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}
{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"When Israel went out of Egypt,","poem":1},{"text":"the house of Jacob from a people of foreign language,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Judah became his sanctuary,","poem":1},{"text":"Israel his dominion.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"The sea saw it, and fled.","poem":1},{"text":"The Jordan was driven back.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"The mountains skipped like rams,","poem":1},{"text":"the little hills like lambs.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"What was it, you sea, that you fled?","poem":1},{"text":"You Jordan, that you turned back?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You mountains, that you skipped like rams?","poem":1},{"text":"You little hills, like lambs?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tremble, you earth, at the presence of the Lord,","poem":1},{"text":"at the presence of the God of Jacob,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"who turned the rock into a pool of water,","poem":1},{"text":"the flint into a spring of waters.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}
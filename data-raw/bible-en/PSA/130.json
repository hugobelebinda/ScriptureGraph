{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"Out of the depths I have cried to you, Yahweh.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lord, hear my voice.","poem":1},{"text":"Let your ears be attentive to the voice of my petitions.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"If you, Yah, kept a record of sins,","poem":1},{"text":"Lord, who could stand?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"But there is forgiveness with you,","poem":1},{"text":"therefore you are feared.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I wait for Yahweh.","poem":1},{"text":"My soul waits.","poem":2},{"lineBreak":true},{"text":"I hope in his word.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"My soul longs for the Lord more than watchmen long for the morning,","poem":1},{"text":"more than watchmen for the morning.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israel, hope in Yahweh,","poem":1},{"text":"for there is loving kindness with Yahweh.","poem":2},{"lineBreak":true},{"text":"Abundant redemption is with him.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"He will redeem Israel from all their sins.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}
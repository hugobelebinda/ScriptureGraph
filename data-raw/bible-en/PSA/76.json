{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. On stringed instruments. A Psalm by Asaph. A song."]},{"type":"verse","number":1,"content":[{"text":"In Judah, God is known.","poem":1},{"text":"His name is great in Israel.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"His tabernacle is also in Salem.","poem":1},{"text":"His dwelling place in Zion.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"There he broke the flaming arrows of the bow,","poem":1},{"text":"the shield, and the sword, and the weapons of war. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Glorious are you, and excellent,","poem":1},{"text":"more than mountains of game.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Valiant men lie plundered,","poem":1},{"text":"they have slept their last sleep.","poem":2},{"lineBreak":true},{"text":"None of the men of war can lift their hands.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"At your rebuke, God of Jacob,","poem":1},{"text":"both chariot and horse are cast into a dead sleep.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"You, even you, are to be feared.","poem":1},{"text":"Who can stand in your sight when you are angry?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"You pronounced judgment from heaven.","poem":1},{"text":"The earth feared, and was silent,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"when God arose to judgment,","poem":2},{"lineBreak":true},{"text":"to save all the afflicted ones of the earth. Selah.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Surely the wrath of man praises you.","poem":1},{"text":"The survivors of your wrath are restrained.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Make vows to Yahweh your God, and fulfill them!","poem":1},{"text":"Let all of his neighbors bring presents to him who is to be feared.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"He will cut off the spirit of princes.","poem":1},{"text":"He is feared by the kings of the earth.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}
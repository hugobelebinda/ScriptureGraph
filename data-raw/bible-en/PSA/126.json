{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["A Song of Ascents."]},{"type":"verse","number":1,"content":[{"text":"When Yahweh brought back those who returned to Zion,","poem":1},{"text":"we were like those who dream.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Then our mouth was filled with laughter,","poem":1},{"text":"and our tongue with singing.","poem":2},{"text":"Then they said among the nations,","poem":1},{"text":"“Yahweh has done great things for them.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yahweh has done great things for us,","poem":1},{"text":"and we are glad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Restore our fortunes again, Yahweh,","poem":1},{"text":"like the streams in the Negev.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Those who sow
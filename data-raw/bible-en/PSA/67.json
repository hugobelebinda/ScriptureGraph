","number":5,"content":[{"text":"Let the peoples praise you, God.","poem":1},{"text":"Let all the peoples praise you.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"The earth has yielded its increase.","poem":1},{"text":"God, even our own God, will bless us.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"God will bless us.","poem":1},{"text":"All the ends of the earth shall fear him.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}
{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Oh come, let’s sing to Yahweh.","poem":1},{"text":"Let’s shout aloud to the rock of our salvation!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Let’s come before his presence with thanksgiving.","poem":1},{"text":"Let’s extol him with songs!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For Yahweh is a great God,","poem":1},{"text":"a great King above all gods.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"In his hand are the deep places of the earth.","poem":1},{"text":"The heights of the mountains are also his.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"The sea is his, and he made it.","poem":1},{"text":"His hands formed the dry land.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oh come, let’s worship and bow down.","poem":1},{"text":"Let’s kneel before Yahweh, our Maker,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"for he is our God.","poem":2},{"text":"We are the people of his pasture,","poem":1},{"text":"and the sheep in his care.","poem":2},{"text":"Today, oh that you would hear his voice!","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Don’t harden your heart, as at Meribah,","poem":2},{"lineBreak":true},{"text":"as in the day of Massah in the wilderness,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"when your fathers tempted me,","poem":1},{"text":"tested me, and saw my work.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Forty long years I was grieved with that generation,","poem":1},{"text":"and said, “They are a people who err in their heart.","poem":2},{"lineBreak":true},{"text":"They have not known my ways.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Therefore I swore in my wrath,","poem":1},{"text":"“They won’t enter into my rest.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}
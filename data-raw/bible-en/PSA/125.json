t":[{"text":"But as for those who turn away to their crooked ways,","poem":1},{"text":"Yahweh will lead them away with the workers of iniquity.","poem":2},{"text":"Peace be on Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}
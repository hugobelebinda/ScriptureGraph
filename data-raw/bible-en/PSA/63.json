{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David, when he was in the desert of Judah."]},{"type":"verse","number":1,"content":[{"text":"God, you are my God.","poem":1},{"text":"I will earnestly seek you.","poem":2},{"text":"My soul thirsts for you.","poem":1},{"text":"My flesh longs for you,","poem":2},{"lineBreak":true},{"text":"in a dry and weary land, where there is no water.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"So I have seen you in the sanctuary,","poem":1},{"text":"watching your power and your glory.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Because your loving kindness is better than life,","poem":1},{"text":"my lips shall praise you.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"So I will bless you while I live.","poem":1},{"text":"I will lift up my hands in your name.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"My soul shall be satisfied as with the richest food.","poem":1},{"text":"My mouth shall praise you with joyful lips,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"when I remember you on my bed,","poem":2},{"lineBreak":true},{"text":"and think about you in the night watches.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For you have been my help.","poem":1},{"text":"I will rejoice in the shadow of your wings.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"My soul stays close to you.","poem":1},{"text":"Your right hand holds me up.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"But those who seek my soul to destroy it","poem":1},{"text":"shall go into the lower parts of the earth.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"They shall be given over to the power of the sword.","poem":1},{"text":"They shall be jackal food.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"But the king shall rejoice in God.","poem":1},{"text":"Everyone who swears by him will praise him,","poem":2},{"lineBreak":true},{"text":"for the mouth of those who speak lies shall be silenced.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}
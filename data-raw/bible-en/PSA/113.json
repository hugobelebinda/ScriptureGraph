{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Praise Yah!","poem":1},{"text":"Praise, you servants of Yahweh,","poem":2},{"lineBreak":true},{"text":"praise Yahweh’s name.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Blessed be Yahweh’s name,","poem":1},{"text":"from this time forward and forever more.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"From the rising of the sun to its going down,","poem":1},{"text":"Yahweh’s name is to be praised.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahweh is high above all nations,","poem":1},{"text":"his glory above the heavens.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Who is like Yahweh, our God,","poem":1},{"text":"who has his seat on high,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"who stoops down to see in heaven and in the earth?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He raises up the poor out of the dust,","poem":1},{"text":"and lifts up the needy from the ash heap,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"that he may set him with princes,","poem":1},{"text":"even with the princes of his people.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"He settles the barren woman in her home","poem":1},{"text":"as a joyful mother of children.","poem":2},{"text":"Praise Yah!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}
"text":"You have given me the heritage of those who fear your name.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"You will prolong the king’s life.","poem":1},{"text":"His years will be for generations.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He shall be enthroned in God’s presence forever.","poem":1},{"text":"Appoint your loving kindness and truth, that they may preserve him.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"So I will sing praise to your name forever,","poem":1},{"text":"that I may fulfill my vows daily.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}
{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["For the Chief Musician. On stringed instruments. A contemplation by David, when the Ziphites came and said to Saul, “Isn’t David hiding himself among us?”"]},{"type":"verse","number":1,"content":[{"text":"Save me, God, by your name.","poem":1},{"text":"Vindicate me in your might.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hear my prayer, God.","poem":1},{"text":"Listen to the words of my mouth.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"For strangers have risen up against me.","poem":1},{"text":"Violent men have sought after my soul.","poem":2},{"lineBreak":true},{"text":"They haven’t set God before them. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Behold, God is my helper.","poem":1},{"text":"The Lord is the one who sustains my soul.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"He will repay the evil to my enemies.","poem":1},{"text":"Destroy them in your truth.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"With a free will offering, I will sacrifice to you.","poem":1},{"text":"I will give thanks to your name, Yahweh, for it is good.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"For he has delivered me out of all trouble.","poem":1},{"text":"My eye has seen triumph over my enemies.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}
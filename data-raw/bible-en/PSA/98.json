{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["A Psalm."]},{"type":"verse","number":1,"content":[{"text":"Sing to Yahweh a new song,","poem":1},{"text":"for he has done marvelous things!","poem":2},{"lineBreak":true},{"text":"His right hand and his holy arm have worked salvation for him.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yahweh has made known his salvation.","poem":1},{"text":"He has openly shown his righteousness in the sight of the nations.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"He has remembered his loving kindness and his faithfulness toward the house of Israel.","poem":1},{"text":"All the ends of the earth have seen the salvation of our God.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Make a joyful noise to Yahweh, all the earth!","poem":1},{"text":"Burst out and sing for joy, yes, sing praises!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sing praises to Yahweh with the harp,","poem":1},{"text":"with the harp and the voice of melody.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"With trumpets and sound of the ram’s horn,","poem":1},{"text":"make a joyful noise before the King, Yahweh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Let the sea roar with its fullness;","poem":1},{"text":"the world, and those who dwell therein.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Let the rivers clap their hands.","poem":1},{"text":"Let the mountains sing for joy together.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Let them sing before Yahweh,","poem":1},{"text":"for he comes to judge the earth.","poem":2},{"text":"He will judge the world with righteousness,","poem":1},{"text":"and the peoples with equity.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}
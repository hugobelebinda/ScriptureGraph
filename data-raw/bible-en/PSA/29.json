{"translation":{"id":"eng_web","name":"World English Bible Classic","website":"https://ebible.org/Scriptures/details.php?id=eng-web","licenseUrl":"https://ebible.org/Scriptures/details.php?id=eng-web","shortName":"WEBC","englishName":"World English Bible Classic","language":"eng","textDirection":"ltr","sha256":"400f57f7109bbfa22509cc69c166b4fa0fbc2b559d60eccc43887b54222d67a6","availableFormats":["json"],"listOfBooksApiLink":"/api/eng_web/books.json","completeTranslationApiLink":"/api/eng_web/complete.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"English","languageEnglishName":"English","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"eng_web","name":"Psalms","commonName":"Psalms","title":"The Psalms","order":19,"numberOfChapters":150,"sha256":"bea793d113d9447c81fc0b57f1315cc24e7bccea3447e2863e4186222fe8944c","firstChapterNumber":1,"firstChapterApiLink":"/api/eng_web/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/eng_web/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["A Psalm by David."]},{"type":"verse","number":1,"content":[{"text":"Ascribe to Yahweh, you sons of the mighty,","poem":1},{"text":"ascribe to Yahweh glory and strength.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ascribe to Yahweh the glory due to his name.","poem":1},{"text":"Worship Yahweh in holy array.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yahweh’s voice is on the waters.","poem":1},{"text":"The God of glory thunders, even Yahweh on many waters.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahweh’s voice is powerful.","poem":1},{"text":"Yahweh’s voice is full of majesty.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahweh’s voice breaks the cedars.","poem":1},{"text":"Yes, Yahweh breaks in pieces the cedars of Lebanon.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He makes them also to skip like a calf;","poem":1},{"text":"Lebanon and Sirion like a young, wild ox.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahweh’s voice strikes with flashes of lightning.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Yahweh’s voice shakes the wilderness.","poem":2},{"lineBreak":true},{"text":"Yahweh shakes the wilderness of Kadesh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yahweh’s voice makes the deer calve,","poem":1},{"text":"and strips the forests bare.","poem":2},{"lineBreak":true},{"text":"In his temple everything says, “Glory!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yahweh sat enthroned at the Flood.","poem":1},{"text":"Yes, Yahweh sits as King forever.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yahweh will give strength to his people.","poem":1},{"text":"Yahweh will bless his people with peace.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}
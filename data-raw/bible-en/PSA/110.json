","number":5,"content":[{"text":"The Lord is at your right hand.","poem":1},{"text":"He will crush kings in the day of his wrath.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"He will judge among the nations.","poem":1},{"text":"He will heap up dead bodies.","poem":2},{"lineBreak":true},{"text":"He will crush the ruler of the whole earth.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"He will drink of the brook on the way;","poem":1},{"text":"therefore he will lift up his head.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}
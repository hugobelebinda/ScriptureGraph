,"content":[{"text":"The sun will not harm you by day,","poem":1},{"text":"nor the moon by night.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yahweh will keep you from all evil.","poem":1},{"text":"He will keep your soul.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yahweh will keep your going out and your coming in,","poem":1},{"text":"from this time forward, and forever more.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/eng_web/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/eng_web/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/eng_web/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}